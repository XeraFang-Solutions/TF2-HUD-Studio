{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TF2 HUD Studio",
  "version": "1.1.2",
  "identifier": "solutions.xerafang.tf2hudstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TF2 HUD Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "app"
    ],
    "publisher": "XeraFang Solutions",
    "copyright": "Copyright (C) 2026 XeraFang Solutions. Licensed under GPL-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Visual editor for Team Fortress 2 HUDs",
    "longDescription": "TF2 HUD Studio is a visual editor for Team Fortress 2 HUDs: an accurate VGUI preview, drag-and-drop layout, scheme and animation editors, and lossless editing of .res files.",
    "homepage": "https://github.com/XeraFang-Solutions/TF2-HUD-Studio",
    "license": "GPL-2.0-only",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
